{
  "name": "MPLADS — Data Ingestion",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ingest-allocations",
        "options": {}
      },
      "id": "7a35e86e-b152-4a0a-b328-98e6c7d24a01",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
