# MPLADS AI Risk Monitoring & Decision Support Platform
# Environment Configuration Template
# NOTE: Never commit actual secrets or the real .env file (per rules.md §13)

NODE_ENV=development
PORT=5000

# Database Configuration
# In local development: mongodb://127.0.0.1:27017/mplads
MONGODB_URI=mongodb://127.0.0.1:27017/mplads

# Client Application URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Authentication & Session Security (Phase 2)
JWT_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CAPTCHA_SECRET=your_captcha_hmac_secret_key_change_in_production

# Account Lockout Protection (Failed Login Attempts)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Document Storage & Upload Limits (Phase 5)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# n8n Automation & Background Service Credentials (Phase 7)
N8N_SERVICE_TOKEN=your_n8n_service_bearer_token_min_32_chars
N8N_WEBHOOK_SECRET=your_n8n_webhook_hmac_secret_key
INTERNAL_API_BASE_URL=http://localhost:5000
N8N_BASE_URL=http://localhost:5678

# AI Analytics Service & Risk Engine (Phase 8 & 9)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_GATEWAY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash
AI_GATEWAY_TIMEOUT_MS=8000


