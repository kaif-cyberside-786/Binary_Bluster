{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "project_id",
      "mp_id",
      "state",
      "district",
      "category",
      "title",
      "status",
      "estimated_cost"
    ],
    "properties": {
      "project_id": {
        "bsonType": "string",
        "pattern": "^[A-Z0-9_-]{4,50}$",
        "description": "Unique canonical project identifier"
      },
      "mp_id": {
        "bsonType": "string",
        "description": "Recommending MP identifier"
      },
      "state": {
        "bsonType": "string"
      },
      "district": {
        "bsonType": "string"
      },
      "category": {
        "enum": [
          "Drinking Water",
          "Education",
          "Health & Family Welfare",
          "Roads & Bridges",
          "Sanitation",
          "Community Hall",
          "Rural Electrification",
          "Irrigation",
          "Sports Infrastructure",
          "Other Public Amenities"
        ]
      },
      "title": {
        "bsonType": "string",
        "maxLength": 300
      },
      "status": {
        "enum": [
          "MP_RECOMMENDED",
          "DISTRICT_REVIEW",
          "CLARIFICATION_REQUIRED",
          "HELD",
          "SANCTIONED",
          "IN_PROGRESS",
          "COMPLETED"
        ],
        "description": "Authoritative lifecycle state per architecture.md §10.1"
      },
      "is_inspection_required": {
        "bsonType": "bool"
      },
      "is_escalated": {
        "bsonType": "bool"
      },
      "estimated_cost": {
        "bsonType": ["double", "int", "long"],
        "minimum": 0
      },
      "sanctioned_cost": {
        "bsonType": ["double", "int", "long", "null"]
      },
      "implementing_agency_id": {
        "bsonType": ["string", "null"]
      },
      "is_real_government_data": {
        "bsonType": "bool"
      },
      "is_synthetic": {
        "bsonType": "bool"
      }
    }
  }
}

